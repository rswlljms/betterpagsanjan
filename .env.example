# Environment variables for BetterPagsanjan.
#
# Copy this file to .env.local for local development and fill in values.
# Real values are never committed: .env* is gitignored and only this
# documentation copy is tracked. In production, set these in the Vercel
# project's Environment Variables settings instead.

# Canonical public URL of the site (no trailing slash).
#
# Required in production. Metadata, canonical URLs, the sitemap, and
# robots.txt all derive from it. When it is unset the site falls back to
# the placeholder https://betterpagsanjan.org, which is NOT registered
# yet — search engines would then be pointed at a domain this project
# does not control. A Vercel build logs a warning while it is unset.
#
# Example: https://betterpagsanjan.org
NEXT_PUBLIC_SITE_URL=

# Google AI Studio key for Ask BetterPagsanjan (POST /api/ask).
#
# Optional. Without it the assistant still answers, deterministically,
# from the civic search index; the model is simply never called. Server
# side only — never use a NEXT_PUBLIC_ prefix here.
LLM_API_KEY=

# Model used for grounded answers. Optional.
# Default: gemini-3.6-flash
LLM_MODEL=
