# Environment variables for BetterPagsanjan.
#
# Copy this file to .env.local for local development and fill in values.
# Real values are never committed: .env* is gitignored and only this
# documentation copy is tracked. In production, set these in the Vercel
# project's Environment Variables settings instead.

# Canonical public URL of the site (no trailing slash).
#
# Required in production. Metadata, the sitemap, and robots.txt all derive
# from it. When it is unset the site falls back to the placeholder
# https://betterpagsanjan.org, which is NOT registered yet — search engines
# would then be pointed at a domain this project does not control. A Vercel
# build logs a warning while it is unset.
#
# Example: https://betterpagsanjan.vercel.app for a first staging deploy,
# then the registered domain once it resolves.
NEXT_PUBLIC_SITE_URL=

# Public launch switch.
#
# Leave unset while the deployment is a staging preview: `/robots.txt`
# disallows all crawling and every response carries an
# `X-Robots-Tag: noindex, nofollow` header, so the deployment stays out of
# search results even if someone finds the URL.
#
# Set to "true" only after NEXT_PUBLIC_SITE_URL points at the production
# domain and the content is ready to be found. Changing it requires a
# redeploy, because robots.txt is prerendered at build time.
SITE_LAUNCHED=

# Google AI Studio key for Ask BetterPagsanjan (POST /api/ask).
#
# Optional. Without it the assistant still answers, deterministically,
# from the civic search index; the model is simply never called. Server
# side only — never use a NEXT_PUBLIC_ prefix here.
LLM_API_KEY=

# Model used for grounded answers. Optional.
# Default: gemini-3.6-flash
LLM_MODEL=
